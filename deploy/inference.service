# 추론 서비스 systemd 템플릿. 직접 복사하지 말고 deploy/install-inference.sh로 설치한다.
# @USER@, @REPO@는 설치 스크립트가 채운다. 서비스 이름은 inference-<계정>이다 (보드를 팀원과 같이 쓰므로).

[Unit]
Description=Inference service (assignment 8, @USER@)
After=network-online.target time-sync.target collector-@USER@.service
Wants=network-online.target
# 네트워크가 오래 끊겨 재시작이 반복돼도 포기하지 않는다 (기본값은 10초에 5번이면 멈춤)
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
ExecStart=@REPO@/.venv/bin/python -m service --config @REPO@/config/service.toml run
Restart=always
RestartSec=5
# 설정 오류(종료 코드 2)는 재시작해도 고쳐지지 않으므로 반복하지 않는다
RestartPreventExitStatus=2
Environment=PYTHONUNBUFFERED=1
# 같은 보드에서 실습 앱(EmbeddingGemma 등)이 메모리를 다 쓰면 커널이 프로세스 하나를 죽인다.
# 그때 센서 서비스가 아니라 실습 앱이 먼저 죽게 점수를 낮춘다 (실습 앱은 practice.sh가 +500으로 올린다)
OOMScoreAdjust=-500
# CPU·디스크가 모자랄 때 실습 앱보다 먼저 차례를 받는다 (기본 100)
CPUWeight=400
IOWeight=400
# 보드 메모리(8GB, GPU 공유)를 다른 서비스·LLM과 나눠 쓰므로 상한을 둔다
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
